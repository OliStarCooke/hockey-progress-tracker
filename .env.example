# Shared tracker configuration. Copy to .env and adjust for your team.
# Docker Compose and `npm start` / `npm run dev` both read these values.
PORT=3210
HOST=127.0.0.1
# To reach the tracker from other devices, set HOST=0.0.0.0 and list the networks
# allowed to connect (comma-separated CIDR subnets). Loopback is always allowed.
# ALLOWED_CLIENTS=192.168.0.0/24
ESPN_LEAGUE_ID=918256829
ESPN_SEASON=2027
# Your ESPN team ID. The dashboard highlights this team as "YOUR TEAM",
# uses it for the differential baseline default, focus button, and summary cards.
# Find it in ESPN's URL or the exported CSV (team_id column). Example: Astra is 3.
TRACKED_TEAM_ID=3
# Minutes between automatic ESPN syncs (1–1440). Live scores replace one snapshot.
SYNC_INTERVAL_MINUTES=5
# Private leagues need ESPN cookies. Point this at a file containing:
#   espn_s2=...
#   SWID=...
# The file is never sent to the browser. Public leagues can leave it missing.
ESPN_SECRETS_PATH=.secrets/espn.env
DATA_DIR=data
